# Рабочие данные портфеля остаются локальными: в них пути машины,
# внутренние оценки проектов и находки по безопасности.
# Публикуются только *.example.json со структурой.
data/*.json
!data/*.example.json
data/snapshots/

# Память системы: записи знания по проектам. Содержимое личное — от заметок
# пользователя до находок ИБ, — поэтому в репозиторий не попадает.
data/memory/

# Журнал механизма развития агента (LEARN-03): попытки, причины, конфигурации моделей — личное (REQ-DATA-04).
data/learning/

# Журнал отказов сервера досок и отчёты сканеров безопасности (SEC-006, SEC-012…014) — личное.
data/security/

# Снимок «Архитектуры систем» (TT-ARCH-001): адреса, порты, процессы и контейнеры машины — личное.
data/arch/

# Пакеты доказательств выпуска (E2E-R39): коммиты, одобрения, находки ИБ — личное.
data/releases/

# Дашборд собирается из данных и содержит их целиком.
dashboard.html

ops/logs/
ops/backups/
__pycache__/
*.pyc
.venv/

# Локальные веса моделей (GGUF): гигабайты и чужая лицензия — только на диске владельца.
models/
*.gguf

# Локальные модели, настройки ассистентов — не в git
llm/
.claude/
.codex/
